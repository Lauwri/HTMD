{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTMD 0.1 semantic projection (draft)",
  "description": "Lossy extracted metadata, references and directed relations. Not a full syntax tree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "htmd",
    "metadata",
    "references",
    "relations"
  ],
  "properties": {
    "htmd": {
      "const": "0.1"
    },
    "metadata": {
      "type": "object",
      "required": [
        "htmd",
        "type"
      ],
      "patternProperties": {
        "^x-[a-z0-9_-]+$": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "additionalProperties": false,
      "properties": {
        "htmd": {
          "const": "0.1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "note",
            "object",
            "component",
            "action",
            "fact",
            "hypothesis",
            "thought",
            "event"
          ]
        },
        "title": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "corrects": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "fact"
              }
            }
          },
          "then": {
            "required": [
              "id",
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "event"
              }
            }
          },
          "then": {
            "required": [
              "id",
              "actor",
              "occurred_at",
              "recorded_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "hypothesis",
                  "thought"
                ]
              }
            }
          },
          "then": {
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "target",
          "line"
        ],
        "properties": {
          "kind": {
            "enum": [
              "context",
              "skill",
              "tool",
              "resource",
              "link"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "link",
              "summary",
              "full"
            ]
          },
          "label": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "type",
          "to",
          "status",
          "line"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "status": {
            "enum": [
              "asserted",
              "inferred",
              "hypothetical"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
