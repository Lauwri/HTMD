  },
  {
    "id": "core-fact",
    "profile": "core",
    "description": "Facts need evidence",
    "source": "---\nhtmd: \"0.1\"\nid: \"mem://facts/one\"\ntype: \"fact\"\nevidence:\n  - \"res://documents/report\"\n---\n\nA sourced assertion.\n",
