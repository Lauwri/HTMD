[
  {
    "id": "core-anonymous",
    "profile": "core",
    "description": "Anonymous Markdown has defaults",
    "source": "# Hello\n\nPlain *Markdown*.\n",
    "valid": true,
    "expected": {
      "metadata": {
        "htmd": "0.1",
        "type": "note"
      },
      "references": [],
      "relations": []
    }
  },
  {
    "id": "core-relation",
    "profile": "core",
    "description": "A document owns its outbound relation",
    "source": "---\nhtmd: \"0.1\"\nid: \"res://examples/device\"\ntype: \"component\"\n---\n\n# Device\n\n<relation type=\"contains\" to=\"res://examples/sensor\" />\n",
    "valid": true,
    "expected": {
      "metadata": {
        "htmd": "0.1",
        "type": "component",
        "id": "res://examples/device"
      },
      "references": [],
      "relations": [
        {
          "from": "res://examples/device",
          "type": "contains",
          "to": "res://examples/sensor",
          "status": "asserted",
          "line": 9
        }
      ]
    }
  },
  {
    "id": "core-inline-link",
    "profile": "core",
    "description": "Labeled inline graph link",
    "source": "See [[res://examples/sensor|sensor]].\n",
    "valid": true,
    "expected": {
      "metadata": {
        "htmd": "0.1",
        "type": "note"
      },
      "references": [
        {
          "kind": "link",
          "target": "res://examples/sensor",
          "label": "sensor",
          "line": 1
        }
      ],
      "relations": []
    }
  },
  {
    "id": "core-dependencies",
    "profile": "core",
    "description": "Context, skill and tool are inert references",
    "source": "<context ref=\"mem://user/preferences\" mode=\"summary\" />\n<skill ref=\"skill://research/core\" />\n<tool ref=\"tool://browser/search\" name=\"Search\" />\n",
    "valid": true,
    "expected": {
      "metadata": {
        "htmd": "0.1",
        "type": "note"
      },
      "references": [
        {
          "kind": "context",
          "target": "mem://user/preferences",
          "mode": "summary",
          "line": 1
        },
        {
          "kind": "skill",
          "target": "skill://research/core",
          "line": 2
        },
        {
          "kind": "tool",
          "target": "tool://browser/search",
          "name": "Search",
          "line": 3
        }
      ],
      "relations": []
    }
  },
  {
    "id": "core-local-file",
